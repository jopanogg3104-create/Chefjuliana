# Configure values securely in Vercel Settings > Environment Variables.
# Do not commit .env files, connection strings, or passwords.
# DATABASE_URL=
# POSTGRES_URL=
# FISH_ADMIN_PASSWORD= (at least 16 characters, server-only)
# SITE_URL=https://your-domain.example
# Local SQLite is used when neither DATABASE_URL nor POSTGRES_URL is present.
# FISH_DB_PATH=/absolute/private/path/thefish.sqlite
